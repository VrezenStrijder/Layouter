<Window x:Class="Layouter.Views.PartitionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Layouter.Views"
        xmlns:models="clr-namespace:Layouter.Models"
        xmlns:FluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="分区设置" Height="660" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}"/>
        </Style>

        <Style x:Key="FormControlStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FormSliderStyle" TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头 ============ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="HeaderTitleText" Text="分区设置" Style="{StaticResource AppPageTitleText}"/>
                <TextBlock Text="调整分区的标题栏外观、内容区透明度与图标尺寸"
                           Style="{StaticResource AppCaptionText}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============ 表单内容 ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">

                <!-- 预设主题 -->
                <GroupBox Header="预设主题">
                    <StackPanel>
                        <TextBlock Text="一键套用成套外观，之后仍可继续微调"
                                   Style="{StaticResource AppCaptionText}"
                                   Margin="0,0,0,10"/>
                        <WrapPanel x:Name="PresetThemePanel"/>
                    </StackPanel>
                </GroupBox>

                <!-- 标题栏设置 -->
                <GroupBox Header="标题栏">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="前景色" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <Border x:Name="TitleForegroundPreview" Style="{StaticResource ColorSwatchStyle}"/>
                            <Button x:Name="TitleForegroundButton" Content="选择颜色"
                                    Style="{StaticResource AppGhostButton}"
                                    Margin="10,0,0,0"
                                    Click="TitleForegroundButton_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="背景色" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <Border x:Name="TitleBackgroundPreview" Style="{StaticResource ColorSwatchStyle}"/>
                            <Button x:Name="TitleBackgroundButton" Content="选择颜色"
                                    Style="{StaticResource AppGhostButton}"
                                    Margin="10,0,0,0"
                                    Click="TitleBackgroundButton_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="字体" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  x:Name="TitleFontComboBox"
                                  Style="{StaticResource FormControlStyle}"
                                  ItemsSource="{Binding Source={x:Static Fonts.SystemFontFamilies}}"
                                  DisplayMemberPath="Source"
                                  SelectionChanged="TitleFontComboBox_SelectionChanged"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="标题大小" Style="{StaticResource FormLabelStyle}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                            <Slider x:Name="TitleFontSizeSlider"
                                    Style="{StaticResource FormSliderStyle}"
                                    Width="150" Minimum="8" Maximum="24" Value="14"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="TitleFontSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="TitleFontSizeText" Text="14"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       MinWidth="28"
                                       Style="{StaticResource AppMutedText}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="文本对齐" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  x:Name="TitleAlignmentComboBox"
                                  Style="{StaticResource FormControlStyle}"
                                  SelectionChanged="TitleAlignmentComboBox_SelectionChanged">
                            <ComboBoxItem Content="左对齐" Tag="Left"/>
                            <ComboBoxItem Content="居中" Tag="Center"/>
                            <ComboBoxItem Content="右对齐" Tag="Right"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- 内容区设置 -->
                <GroupBox Header="内容区">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="透明度" Style="{StaticResource FormLabelStyle}"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider"
                                    Minimum="0.3" Maximum="1.0" Value="0.90"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       MinWidth="40"
                                       Style="{StaticResource AppMutedText}"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="图标大小" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  x:Name="IconSizeComboBox"
                                  Style="{StaticResource FormControlStyle}"
                                  SelectionChanged="IconSizeComboBox_SelectionChanged">
                            <ComboBoxItem Content="小 (32×32)" Tag="Small"/>
                            <ComboBoxItem Content="中 (48×48)" Tag="Medium"/>
                            <ComboBoxItem Content="大 (64×64)" Tag="Large"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="文本大小" Style="{StaticResource FormLabelStyle}"/>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="TextSizeSlider"
                                    Minimum="8" Maximum="24" Value="12"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    TickPlacement="BottomRight"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ElementName=TextSizeSlider, Path=Value, StringFormat={}{0}px}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       MinWidth="40"
                                       Style="{StaticResource AppMutedText}"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- 预览 -->
                <GroupBox Header="预览">
                    <Border x:Name="PreviewBorder"
                            Height="160"
                            CornerRadius="6"
                            Background="#33FFFFFF"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{Binding ElementName=TitleBackgroundPreview, Path=Background}"
                                    Height="32" Padding="12,0">
                                <TextBlock Text="分区标题预览"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding ElementName=TitleForegroundPreview, Path=Background}"
                                           FontFamily="{Binding ElementName=TitleFontComboBox, Path=SelectedItem}"
                                           FontSize="{Binding ElementName=TitleFontSizeSlider, Path=Value}"
                                           HorizontalAlignment="{Binding ElementName=TitleAlignmentComboBox, Path=SelectedItem.Tag}"/>
                            </Border>

                            <WrapPanel Grid.Row="1" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Border Width="32" Height="32" Background="#FFCFD8E7" CornerRadius="4" Margin="6"
                                        Visibility="{Binding ElementName=IconSizeComboBox, Path=SelectedItem.Tag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Small}"/>
                                <Border Width="48" Height="48" Background="#FFCFD8E7" CornerRadius="4" Margin="6"
                                        Visibility="{Binding ElementName=IconSizeComboBox, Path=SelectedItem.Tag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Medium}"/>
                                <Border Width="64" Height="64" Background="#FFCFD8E7" CornerRadius="4" Margin="6"
                                        Visibility="{Binding ElementName=IconSizeComboBox, Path=SelectedItem.Tag, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Large}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 底部按钮 ============ -->
        <Border Grid.Row="2"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Button x:Name="ResetButton" Content="恢复默认"
                        Style="{StaticResource AppGhostButton}"
                        HorizontalAlignment="Left"
                        Click="ResetButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消"
                            Style="{StaticResource AppGhostButton}"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="保存"
                            Style="{StaticResource AppPrimaryButton}"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
