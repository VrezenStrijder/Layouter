<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Layouter.Views.DesktopManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Layouter.ViewModels"
        xmlns:local="clr-namespace:Layouter.Views"
        xmlns:FluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="分区管理器"
        Height="240" Width="460"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="#20808080"
        BorderThickness="0"
        Opacity="{Binding Opacity}"
        AllowDrop="True"
        ResizeMode="CanResizeWithGrip"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 标题栏按钮：悬浮时显示半透明高亮 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置弹层中的菜单项 -->
        <Style x:Key="PopupMenuItemStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AppAccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="PartitionContextMenu">
            <MenuItem Header="自动排列图标" Click="AutoArrange_Click"/>
            <MenuItem Header="对齐所有分区" Click="AlignPartitions_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="IconContextMenu">
            <MenuItem Header="打开" Click="MenuItem_Open"/>
            <!--<MenuItem Header="删除" Click="MenuItem_Delete"/>
            <Separator />
            <MenuItem Header="属性" Click="MenuItem_Properties"/>-->
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="8" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" x:Name="IconsRowDefinition"/>
                </Grid.RowDefinitions>

                <!-- 分区标题栏 -->
                <Border Grid.Row="0" Background="{Binding TitleBackground}" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseLeftButtonUp="TitleBar_MouseLeftButtonUp" >
                    <Grid>
                        <Label Background="Transparent" MouseDoubleClick="DoubleClickHandler" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" Padding="0" Margin="0" />
                        <!-- 标题栏 -->
                        <Grid x:Name="TitleBar" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBlock x:Name="TitleTextBlock" Text="{Binding Name}" Foreground="{Binding TitleForeground}"  Margin="10,0" FontSize="{Binding TitleFontSize}"
                                       FontFamily="{Binding TitleFont}" VerticalAlignment="Center" MouseDown="TitleTextBlock_MouseDown">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- 左对齐 -->
                                                <DataTrigger Binding="{Binding TitleAlignment}" Value="Left">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                </DataTrigger>
                                                <!-- 居中 -->
                                                <DataTrigger Binding="{Binding TitleAlignment}" Value="Center">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </DataTrigger>
                                                <!-- 右对齐 -->
                                                <DataTrigger Binding="{Binding TitleAlignment}" Value="Right">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 标题编辑框 -->
                                <TextBox x:Name="TitleEditBox" Visibility="Collapsed" Margin="10,3" KeyDown="TitleEditBox_KeyDown" LostFocus="TitleEditBox_LostFocus"/>
                            </Grid>
                            <!-- 功能按钮区域 -->
                            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                <!-- 新增分区按钮 -->
                                <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="新建分区" Click="NewPartition_Click" x:Name="NewPartitionButton">
                                    <FluentIcons:SymbolIcon Symbol="Add" FontSize="16" Foreground="{Binding TitleForeground}" />
                                </Button>

                                <!-- 锁定按钮 -->
                                <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="未锁定" Click="LockButton_Click" x:Name="LockButton">
                                    <FluentIcons:SymbolIcon Symbol="LockOpen" FontSize="16" Foreground="{Binding TitleForeground}" x:Name="LockIcon" />
                                </Button>

                                <!-- 设置按钮 -->
                                <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="设置" Click="Settings_Click" x:Name="SettingsButton">
                                    <FluentIcons:SymbolIcon Symbol="Settings" FontSize="16" Foreground="{Binding TitleForeground}" />
                                </Button>
                            </StackPanel>

                            <!-- 设置菜单 -->
                            <Popup x:Name="SettingsPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="{StaticResource AppSurfaceBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AppCornerRadius}"
                                        Padding="3"
                                        Margin="0,4,0,0">
                                    <StackPanel>
                                        <Button Content="分区设置" Click="PartitionSettings_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                        <Button Content="删除分区" Click="DeletePartition_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                        <Separator/>
                                        <Button Content="对齐图标" Click="AutoArrange_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                        <Button Content="对齐分区" Click="AlignPartitions_Click" Style="{StaticResource PopupMenuItemStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 图标区域 -->
                <Border x:Name="IconsContainer" Grid.Row="1" Background="{Binding ContentBackground}" CornerRadius="0,0,8,8">
                    <ItemsControl ItemsSource="{Binding Icons}" Margin="5,5,5,5"
                     AllowDrop="True" Background="Transparent"
                     x:Name="iconsContainer"
                     PreviewMouseLeftButtonDown="IconsContainer_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="IconsContainer_PreviewMouseMove"
                     Drop="IconsContainer_Drop"
                     ContextMenu="{StaticResource PartitionContextMenu}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True" Background="{Binding BackgroundColor}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Position.X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Position.Y}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="IconHighlight"
                                        CornerRadius="6"
                                        Padding="2"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="Icon_MouseDown"
                                        MouseLeftButtonUp="Icon_MouseUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1FFFFFFF"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <!-- 图标 -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- 使用文件系统图标：同时传入显示尺寸，以便按原生分辨率取图，避免拉伸后模糊 -->
                                            <Image Width="{Binding Size.Width}" Height="{Binding Size.Height}"
                                                   Stretch="Uniform" Margin="10,2,10,5"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource FilePathToIconConverter}">
                                                        <Binding Path="IconPath"/>
                                                        <Binding Path="Size"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                            <!-- 文件名称：白色文字 + 深色投影，保证在深色/浅色壁纸上都清晰可读 -->
                                            <TextBlock Text="{Binding Name}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       FontSize="{Binding TextSize}"
                                                       MaxWidth="60"
                                                       Foreground="White">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black"
                                                                      BlurRadius="5"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.9"
                                                                      RenderingBias="Quality"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Border>
            </Grid>
        </Border>
    </Grid>


</Window>
