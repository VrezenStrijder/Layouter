<Window x:Class="Layouter.Views.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:FluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="提示"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource AppFontSizeBody}">

    <!-- 卡片本体：白底圆角 + 柔和投影，悬浮在应用之上 -->
    <Border x:Name="RootBorder"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCornerRadiusLarge}"
            Padding="24,22"
            MinWidth="360"
            MaxWidth="460"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270" Color="#0F172A" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧圆形图标徽章 -->
            <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,16,0">
                <Ellipse x:Name="BadgeEllipse" Fill="{StaticResource AppAccentBrush}"/>
                <FluentIcons:SymbolIcon x:Name="BadgeIcon"
                                         Symbol="Info"
                                         FontSize="20"
                                         Foreground="White"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Grid>

            <!-- 右侧标题 / 正文 / 按钮 -->
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText"
                           Text="提示"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="MessageText"
                           Margin="0,10,0,0"
                           FontSize="{StaticResource AppFontSizeBody}"
                           LineHeight="22"
                           Foreground="{StaticResource AppTextSecondaryBrush}"
                           TextWrapping="Wrap"/>

                <!-- 按钮行 -->
                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0">
                    <Button x:Name="CancelButton"
                            Content="取消"
                            MinWidth="88"
                            Margin="0,0,10,0"
                            Background="{StaticResource AppSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderStrongBrush}"
                            BorderThickness="1"
                            Foreground="{StaticResource AppTextBrush}"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="OkButton"
                            Content="确定"
                            MinWidth="88"
                            Style="{StaticResource AppPrimaryButton}"
                            IsDefault="True"
                            Click="OkButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
