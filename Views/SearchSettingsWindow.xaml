<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Layouter.Views.SearchSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:FluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="搜索设置"
        Width="640" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="搜索设置"
                       Style="{StaticResource AppPageTitleText}"/>
            <TextBlock Text="控制全局搜索的检索范围与灵敏度，修改后立即生效"
                       Style="{StaticResource AppCaptionText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ============ 全盘搜索开关 ============ -->
                <Border Style="{StaticResource AppCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <FluentIcons:SymbolIcon Symbol="Globe"
                                                    FontSize="14"
                                                    Foreground="{StaticResource AppAccentBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,7,0"/>
                            <TextBlock Text="全盘搜索"
                                       Style="{StaticResource AppSectionTitleText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="开启后，搜索结果会在分区图标之后追加一个「文件系统」区块，检索所有磁盘上的文件；关闭时只搜索分区内的图标。"
                                   Style="{StaticResource AppCaptionText}"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="EnableFileSystemSearchCheck"
                                  Content="启用全盘搜索"
                                  Checked="EnableFileSystemSearch_Changed"
                                  Unchecked="EnableFileSystemSearch_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ============ 最短搜索字符数 ============ -->
                <Border Style="{StaticResource AppCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <FluentIcons:SymbolIcon Symbol="TextGrammarSettings"
                                                    FontSize="14"
                                                    Foreground="{StaticResource AppAccentBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,7,0"/>
                            <TextBlock Text="最短搜索字符数"
                                       Style="{StaticResource AppSectionTitleText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="输入达到该长度后才会检索全盘文件。单个字符命中量极大、几乎没有参考价值，所以默认设为 2 个字符；分区内的图标搜索不受此限制。"
                                   Style="{StaticResource AppCaptionText}"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="MinSearchLengthCombo"
                                      Width="110"
                                      SelectionChanged="MinSearchLength_Changed"/>
                            <TextBlock x:Name="MinSearchLengthHint"
                                       Style="{StaticResource AppCaptionText}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 文件索引 ============ -->
                <Border Style="{StaticResource AppCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <FluentIcons:SymbolIcon Symbol="Database"
                                                    FontSize="14"
                                                    Foreground="{StaticResource AppAccentBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,7,0"/>
                            <TextBlock Text="文件索引"
                                       Style="{StaticResource AppSectionTitleText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="全盘搜索依赖程序自己维护的文件名索引，不依赖 Windows 搜索索引，因此结果完整、响应更快。索引每 24 小时自动更新一次；新增文件想立刻搜到，可手动重建。"
                                   Style="{StaticResource AppCaptionText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                        <Border Background="{StaticResource AppSubtleSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource AppCornerRadius}"
                                Padding="12,10"
                                Margin="0,12,0,0">
                            <TextBlock x:Name="IndexStatusText"
                                       FontSize="12.5"
                                       Foreground="{StaticResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="正在读取索引状态…"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="RebuildButton"
                                    Style="{StaticResource AppPrimaryButton}"
                                    Click="Rebuild_Click">
                                <StackPanel Orientation="Horizontal">
                                    <FluentIcons:SymbolIcon Symbol="ArrowClockwise"
                                                            FontSize="13"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0"/>
                                    <TextBlock x:Name="RebuildButtonText"
                                               Text="重建索引"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Content="打开索引目录"
                                    Style="{StaticResource AppGhostButton}"
                                    Margin="8,0,0,0"
                                    Click="OpenIndexFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 快捷键入口 ============ -->
                <Border Style="{StaticResource AppCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <FluentIcons:SymbolIcon Symbol="Keyboard"
                                                        FontSize="14"
                                                        Foreground="{StaticResource AppAccentBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,7,0"/>
                                <TextBlock Text="快捷键"
                                           Style="{StaticResource AppSectionTitleText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="搜索窗口的唤起快捷键，以及其他功能的快捷键"
                                       Style="{StaticResource AppCaptionText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="快捷键设置…"
                                Style="{StaticResource AppGhostButton}"
                                VerticalAlignment="Center"
                                Click="HotkeySettings_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="FooterHint"
                       Style="{StaticResource AppCaptionText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       TextWrapping="Wrap"
                       Margin="0,0,120,0"/>

            <Button Content="关闭"
                    Style="{StaticResource AppPrimaryButton}"
                    HorizontalAlignment="Right"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
