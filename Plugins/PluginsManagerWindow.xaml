<Window x:Class="Layouter.Plugins.PluginsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Layouter.Plugins"
        xmlns:controls="clr-namespace:Layouter.Plugins.Controls"
        xmlns:FluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        mc:Ignorable="d"
        Title="插件管理" Height="640" Width="960" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="CenteredCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头 ============ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="插件管理" Style="{StaticResource AppPageTitleText}"/>
                    <TextBlock Text="导入、配置与扩展 Layouter 的功能模块"
                               Style="{StaticResource AppCaptionText}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource AppGhostButton}" Click="RefreshPlugins_Click">
                        <StackPanel Orientation="Horizontal">
                            <FluentIcons:SymbolIcon Symbol="ArrowSync" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppGhostButton}" Click="ImportPlugin_Click">
                        <StackPanel Orientation="Horizontal">
                            <FluentIcons:SymbolIcon Symbol="ArrowDownload" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="导入插件" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButton}" Command="{Binding CreatePluginCommand}">
                        <StackPanel Orientation="Horizontal">
                            <FluentIcons:SymbolIcon Symbol="Add" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="创建插件" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 内容 ============ -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="20,12,20,0">
            <TabItem Header="插件列表" x:Name="PluginsListTab">
                <Grid Margin="0,12,0,0">
                    <DataGrid x:Name="PluginsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CellStyle="{StaticResource CenteredCellStyle}"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称"
                                                Binding="{Binding Name}"
                                                Width="1.2*"
                                                MinWidth="140"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource AppTableCellText}"/>
                            <DataGridTextColumn Header="版本"
                                                Binding="{Binding Version}"
                                                Width="80"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource AppTableCellText}"/>
                            <DataGridTextColumn Header="描述"
                                                Binding="{Binding Description}"
                                                Width="2*"
                                                MinWidth="200"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource AppTableCellText}"/>
                            <DataGridTextColumn Header="作者"
                                                Binding="{Binding Author}"
                                                Width="110"
                                                IsReadOnly="True"
                                                ElementStyle="{StaticResource AppTableCellText}"/>
                            <DataGridTemplateColumn Header="启用" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  Click="PluginEnabled_Click"
                                                  Tag="{Binding Id}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="编辑"
                                                    Style="{StaticResource AppTableActionButton}"
                                                    Click="EditPlugin_Click"
                                                    Tag="{Binding Id}"/>
                                            <Button Content="参数设置"
                                                    Style="{StaticResource AppTableActionButton}"
                                                    Click="PluginSettings_Click"
                                                    Tag="{Binding Id}"/>
                                            <Button Content="删除"
                                                    Style="{StaticResource AppTableDangerButton}"
                                                    Click="DeletePlugin_Click"
                                                    Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock x:Name="StatusBar" Text="准备就绪" Style="{StaticResource AppCaptionText}"/>
        </Border>
    </Grid>
</Window>
