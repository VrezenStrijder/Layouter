<UserControl x:Class="Layouter.Controls.AppToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:FluentIcons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="{StaticResource AppFontSizeBody}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Focusable="False"
             IsTabStop="False"
             Cursor="Hand">

    <!--
        通知卡片：白色圆角卡片 + 柔和阴影 + 左侧语义色细条
        配色全部取自 Styles/Theme.xaml 中的设计令牌
    -->
    <Border x:Name="CardBorder"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AppCornerRadiusLarge}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#1F2937" Opacity="0.26"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧语义色细条（圆角与卡片一致：AppCornerRadiusLarge 10 - 1px 边框） -->
            <Border x:Name="AccentStripe"
                    Grid.Column="0"
                    Width="4"
                    Margin="-1,0,0,-1"
                    Background="{StaticResource AppAccentBrush}"
                    CornerRadius="9,0,0,9"/>

            <!-- 卡片内容区 -->
            <Grid Grid.Column="1" Margin="12,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 圆形图标徽章 -->
                <Grid Grid.Column="0"
                      Width="36"
                      Height="36"
                      VerticalAlignment="Top">
                    <Ellipse x:Name="BadgeEllipse"
                             Fill="{StaticResource AppAccentBrush}"/>
                    <FluentIcons:SymbolIcon x:Name="BadgeIcon"
                                             Symbol="Info"
                                             FontSize="18"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Grid>

                <!-- 文本区：标题 / 正文 / 时间戳 -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               TextWrapping="Wrap"
                               TextOptions.TextFormattingMode="Ideal"/>

                    <TextBlock x:Name="MessageText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{StaticResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="TimestampText"
                               Margin="0,4,0,0"
                               FontSize="{StaticResource AppFontSizeCaption}"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               TextOptions.TextFormattingMode="Ideal"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
